   "source": [
    "### Counting Bits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "c92403e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Solution:\n",
    "    def countBits(self, n: int) -> list[int]:\n",
    "      ans = [0] * (n+1)\n",
    "      for i in range(n+1):\n",
    "        ans[i] = bin(i).count('1')\n",
    "        \n",
    "      return ans"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "34297908",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[0, 1, 1, 2, 1, 2, 2, 3, 1]\n"
     ]
    }
   ],
   "source": [
    "s = Solution()\n",
    "\n",
    "print(s.countBits(8))"
   ]
  }
